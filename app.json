{
  "expo": {
    "name": "hōm",
    "slug": "homeapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homeapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homeapp.mobile"
    },
    "android": {
      "package": "com.homeapp.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/hom-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FBF3EA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1f06c646-56ef-4608-9348-b1a313a3bd2e"
      }
    },
    "owner": "mckev23",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1f06c646-56ef-4608-9348-b1a313a3bd2e"
    }
  }
}
